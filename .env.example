# Copy this file to `.env` and fill in your values.  NEVER commit `.env`.
# Both `uvicorn app:app` and `docker compose up` load `.env` automatically.

# ---------------------------------------------------------------------------
# LLM  (required for /plan + self-heal) — pick ONE provider block
# ---------------------------------------------------------------------------
# Option A: Google Gemini. Key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=put-your-gemini-key-here

# Option B: OpenAI-compatible endpoint (Azure OpenAI / Foundry /models route).
# LLM_PROVIDER=openai
# LLM_MODEL=Phi-4-mini-reasoning
# OPENAI_BASE_URL=https://<your-resource>.services.ai.azure.com/models
# OPENAI_API_KEY=put-your-foundry-key-here
# OPENAI_API_VERSION=2024-05-01-preview   # omit on the /openai/v1 route

# Structured-output mode override (default: tool for Claude, prompted otherwise).
# LLM_OUTPUT_MODE=tool|prompted|native

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# MOCK=true  -> local dry-run: /approve writes to mock_tenant/ and simulates the
#               run. No Azure needed. Great for trying the full UI flow.
# MOCK=false -> real Azure build + run (requires the AZURE_* vars below).
MOCK=true
SELF_HEAL=false

# ---------------------------------------------------------------------------
# Azure deploy target  (used only when MOCK=false)
#
# OPTIONAL here: all of these can be entered (and tested) in the UI's
# "Azure connection" panel at runtime instead — nothing needs to live in a file.
# Values below act as defaults the UI pre-fills.
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
ADF_FACTORY_NAME=
ADLS_ACCOUNT_NAME=
# ADLS_ACCOUNT_URL defaults to https://<ADLS_ACCOUNT_NAME>.dfs.core.windows.net
ADLS_ACCOUNT_URL=
# STORAGE_KIND=blob for a plain Blob account (no hierarchical namespace), adls for Gen2
STORAGE_KIND=
AZURE_LOCATION=eastus

# Service principal (omit all three to use `az login` / Managed Identity instead)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
